rules_version = '2';

// KORASTORE Firestore security rules (rules-only design, no server).
//
// Money and stock are changed directly by the browser, so these rules are the only
// protection. They allow a change only when it matches the matching record written in
// the same batch:
//
//  - A customer's wallet can go DOWN only in a batch that creates their own paid order
//    whose total equals the balance decrease (prices are re-read from /products, and the
//    total must be items + platform service fee + delivery fee).
//  - A customer's wallet can never go UP. Funding is credited by the admin only.
//  - Stock can go DOWN only in a batch that creates the order that includes that product.
//  - Orders are created once (create-only), so a retried checkout can't double-charge.
//  - Boost orders are paid the same way: the total must be the plan's price per unit ×
//    quantity. A plan may price a unit at a fraction of ₦1 (₦0.10 minimum), so the money
//    is worked out in kobo and rounded to whole naira (never below ₦1) — the wallet holds
//    no kobo.
//  - Checkout fees are fixed by the fee schedule in /settings/fees (admin-edited), with
//    built-in defaults: ₦2,000 platform service fee, ₦2,500 delivery inside the store's
//    local state, ₦6,000 delivery anywhere else.
//  - Product documents use the admin-chosen product ID as their id (3–40 of A–Z a–z 0–9 _ -).
//  - Approved admin accounts (email + verified email) approve funding, move order status,
//    cancel with refunds, list products and announce recommended ones. Admins can set any
//    balance; that trust is by design.
//
// Limits: a cart is capped at 5 lines per order (rules have no loops, so each line is
// checked by index). Each line's quantity is limited by the product's available stock.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admins: approved email addresses, each with a verified email address.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'beniwealth70@gmail.com',
          'okogbagideon28@gmail.com'
        ]
        && request.auth.token.email_verified == true;
    }

    function isText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // Line i of a list, or 0 when the list is shorter than i+1.
    function numAt(list, i, field) {
      return list.size() > i ? list[i][field] : 0;
    }

    // Quantity this order buys for productId (sums duplicate lines).
    function qtyFor(list, productId) {
      return (list.size() > 0 && list[0].productId == productId ? list[0].quantity : 0)
        + (list.size() > 1 && list[1].productId == productId ? list[1].quantity : 0)
        + (list.size() > 2 && list[2].productId == productId ? list[2].quantity : 0)
        + (list.size() > 3 && list[3].productId == productId ? list[3].quantity : 0)
        + (list.size() > 4 && list[4].productId == productId ? list[4].quantity : 0);
    }

    // The pickup station document (a station that does not exist fails the rule; the
    // lookups below share one cached read of the same document).
    function pickupStation(id) {
      return get(/databases/$(database)/documents/pickupStations/$(id)).data;
    }

    // What a boost order costs: the plan's price per unit × quantity, worked out in
    // kobo (a plan may price a unit at a fraction of ₦1, e.g. ₦0.10) and rounded to
    // whole naira because the wallet only ever holds whole naira — never below ₦1.
    // Mirrors boostOrderTotal() in store.js.
    function boostOrderTotal(unitPrice, quantity) {
      let total = math.round(math.round(unitPrice * 100.0) * quantity / 100.0);
      return total < 1 ? 1 : total;
    }

    // Checkout fee schedule. The admin edits /settings/fees; before it exists the
    // built-in defaults apply, so checkout works from day one. Cached lookups of the
    // same document do not count against the rules lookup limit.
    function feeData() {
      return exists(/databases/$(database)/documents/settings/fees)
        ? get(/databases/$(database)/documents/settings/fees).data
        : {'serviceFee': 2000, 'deliveryLocal': 2500, 'deliveryNigeria': 6000, 'localState': 'Lagos'};
    }

    function serviceFeeAmount() {
      return feeData().get('serviceFee', 2000);
    }

    // Cheaper delivery only inside the store's local state; everywhere else uses the
    // nationwide rate.
    function deliveryFeeAmount(delivery) {
      return (delivery.country == 'Nigeria' && delivery.state == feeData().get('localState', 'Lagos'))
        ? feeData().get('deliveryLocal', 2500)
        : feeData().get('deliveryNigeria', 6000);
    }

    // One order line: must match the product as it is now in /products, including the
    // chosen variation for clothing products.
    function lineMatchesProduct(line) {
      let product = get(/databases/$(database)/documents/products/$(line.productId)).data;
      return line.keys().hasOnly(['productId', 'name', 'price', 'quantity', 'lineTotal', 'variant', 'variantIndex'])
        && line.productId is string
        && line.name == product.name
        && line.variantIndex is int && line.variantIndex >= -1
        && line.variant is string && line.variant.size() <= 40
        && line.price is int
        && ((line.variantIndex == -1
              && line.variant == ''
              && line.price == product.price
              && product.get('variations', []).size() == 0)
          || (line.variantIndex >= 0
              && line.variantIndex < product.get('variations', []).size()
              && product.variations[line.variantIndex].name == line.variant
              && product.variations[line.variantIndex].price == line.price))
        && line.quantity is int && line.quantity >= product.get('minOrderQuantity', 1)
        && line.lineTotal == line.price * line.quantity
        && product.active == true
        && product.stock >= line.quantity;
    }

    // ---------------------------------------------------------------
    // Customer profile and wallet: /users/{uid}
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // A new customer profile starts with no wallet fields.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp;

      // Profile edits (name, the record-only delivery address and the chosen pickup
      // station — saved here, never in the browser). Balance may NOT change here.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'country', 'state', 'lga', 'address', 'pickup', 'updatedAt'
        ])
        && (!('country' in request.resource.data) || request.resource.data.country is string)
        && (!('state' in request.resource.data) || request.resource.data.state is string)
        && (!('lga' in request.resource.data) || request.resource.data.lga is string)
        && (!('address' in request.resource.data) || request.resource.data.address is string)
        && (!('address' in request.resource.data) || request.resource.data.address.size() <= 300)
        // The station is picked from the store's catalogue: the id, name, state and
        // address saved here must match the station document itself.
        && (!('pickup' in request.resource.data)
          || request.resource.data.pickup == null
          || (request.resource.data.pickup is map
            && request.resource.data.pickup.keys().hasOnly(['stationId', 'stationName', 'state', 'address', 'landmark'])
            && request.resource.data.pickup.stationId is string
            && request.resource.data.pickup.stationId.matches('^[A-Za-z0-9_-]{2,40}$')
            && request.resource.data.pickup.stationName is string && request.resource.data.pickup.stationName.size() <= 120
            && request.resource.data.pickup.state is string && request.resource.data.pickup.state.size() <= 40
            && request.resource.data.pickup.address is string && request.resource.data.pickup.address.size() <= 300
            && request.resource.data.pickup.landmark is string && request.resource.data.pickup.landmark.size() <= 120
            && exists(/databases/$(database)/documents/pickupStations/$(request.resource.data.pickup.stationId))
            && pickupStation(request.resource.data.pickup.stationId).name == request.resource.data.pickup.stationName
            && pickupStation(request.resource.data.pickup.stationId).state == request.resource.data.pickup.state));

      // Purchase debit: the wallet goes down, and only for the order created in this batch.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'lastOrderId', 'updatedAt'])
        && request.resource.data.balance is int
        && request.resource.data.balance >= 0
        && request.resource.data.balance < resource.data.get('balance', 0)
        && request.resource.data.lastOrderId is string
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.total
             == resource.data.get('balance', 0) - request.resource.data.balance;

      // Boost purchase debit: the wallet goes down, and only for the boost order
      // created in this batch.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'lastBoostOrderId', 'updatedAt'])
        && request.resource.data.balance is int
        && request.resource.data.balance >= 0
        && request.resource.data.balance < resource.data.get('balance', 0)
        && request.resource.data.lastBoostOrderId is string
        && getAfter(/databases/$(database)/documents/boostOrders/$(request.resource.data.lastBoostOrderId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/boostOrders/$(request.resource.data.lastBoostOrderId)).data.total
             == resource.data.get('balance', 0) - request.resource.data.balance;

      // Admin: funding credits, refunds and corrections.
      allow update: if isAdmin();

      allow delete: if false;

      // Wallet history: the owner can read it. The owner may only add a purchase record
      // that matches an order they created. Admin writes funding and refund records.
      match /transactions/{txId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.type == 'purchase'
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.uid == uid
          && request.resource.data.amount == -getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.total;
        allow create: if isOwner(uid)
          && request.resource.data.type == 'boost'
          && getAfter(/databases/$(database)/documents/boostOrders/$(request.resource.data.orderId)).data.uid == uid
          && request.resource.data.amount == -getAfter(/databases/$(database)/documents/boostOrders/$(request.resource.data.orderId)).data.total;
        allow create: if isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------------
    // Products: /products/{productId} — the document id IS the admin-chosen product ID
    // ---------------------------------------------------------------
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();

      allow create: if isAdmin()
        && productId.matches('^[A-Za-z0-9_-]{3,40}$')
        && isText(request.resource.data.name, 120)
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.get('minOrderQuantity', 1) is int
        && request.resource.data.get('minOrderQuantity', 1) >= 1
        && request.resource.data.get('variations', []) is list
        && request.resource.data.get('variations', []).size() <= 40
        && request.resource.data.active is bool
        && (!('compareAtPrice' in request.resource.data)
          || (request.resource.data.compareAtPrice is int
            && (request.resource.data.compareAtPrice == 0
              || request.resource.data.compareAtPrice >= request.resource.data.price)))
        && (!('images' in request.resource.data)
          || (request.resource.data.images is list
            && request.resource.data.images.size() <= 5
            && (request.resource.data.images.size() == 0
              || (request.resource.data.images[0] is string && request.resource.data.images[0].size() <= 250000)
              && (request.resource.data.images.size() <= 1
                || (request.resource.data.images[1] is string && request.resource.data.images[1].size() <= 250000))
              && (request.resource.data.images.size() <= 2
                || (request.resource.data.images[2] is string && request.resource.data.images[2].size() <= 250000))
              && (request.resource.data.images.size() <= 3
                || (request.resource.data.images[3] is string && request.resource.data.images[3].size() <= 250000))
              && (request.resource.data.images.size() <= 4
                || (request.resource.data.images[4] is string && request.resource.data.images[4].size() <= 250000)))))
        && (!('keywords' in request.resource.data)
          || (request.resource.data.keywords is list && request.resource.data.keywords.size() <= 20))
        && (!('recommended' in request.resource.data) || request.resource.data.recommended is bool);

      allow update: if isAdmin()
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.get('minOrderQuantity', 1) is int
        && request.resource.data.get('minOrderQuantity', 1) >= 1
        && request.resource.data.get('variations', []) is list
        && request.resource.data.get('variations', []).size() <= 40
        && (!('compareAtPrice' in request.resource.data)
          || (request.resource.data.compareAtPrice is int
            && (request.resource.data.compareAtPrice == 0
              || request.resource.data.compareAtPrice >= request.resource.data.price)))
        && (!('images' in request.resource.data)
          || (request.resource.data.images is list && request.resource.data.images.size() <= 5))
        && (!('recommended' in request.resource.data) || request.resource.data.recommended is bool);

      // A customer's purchase: stock goes down and sold goes up by exactly the quantity
      // in the order created in this batch (named in lastOrderId).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'sold', 'updatedAt', 'lastOrderId'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.sold == resource.data.get('sold', 0) + (resource.data.stock - request.resource.data.stock)
        && request.resource.data.lastOrderId is string
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.status == 'paid'
        && qtyFor(getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.items, productId)
             == resource.data.stock - request.resource.data.stock;

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Bank details, checkout fees and the pickup catalogue summary: /settings/{docId}
    // ---------------------------------------------------------------
    match /settings/{docId} {
      allow read: if signedIn() || isAdmin();
      allow write: if isAdmin();
    }

    // The pickup catalogue summary (which states have stations, and how many) is not
    // private: the cart's station picker shows it before sign-in. Writes stay admin-only
    // above.
    match /settings/pickupStations {
      allow read: if true;
    }

    // ---------------------------------------------------------------
    // Pickup stations: /pickupStations/{stationId} — the collection points orders are
    // collected from. Published by the admin from data/jumia-pickup-stations.json; every
    // visitor can read the active ones. An order (and a profile) may only name a station
    // that exists here, and the name, state and address on it must match this document —
    // which also pins the order's state (and so its delivery fee) to the real station.
    // ---------------------------------------------------------------
    match /pickupStations/{stationId} {
      allow read: if resource.data.active == true || isAdmin();

      allow create: if isAdmin()
        && stationId.matches('^[A-Za-z0-9_-]{2,40}$')
        && isText(request.resource.data.name, 120)
        && isText(request.resource.data.state, 40)
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.landmark is string
        && request.resource.data.landmark.size() <= 120
        && (!('latitude' in request.resource.data) || request.resource.data.latitude is number)
        && (!('longitude' in request.resource.data) || request.resource.data.longitude is number)
        && request.resource.data.active is bool;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Orders: /orders/{uid}_{requestId}
    // ---------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();

      // A customer creates an order once. Every line must match current prices and
      // variations, the total must be items + platform service fee + delivery fee from
      // the fee schedule, the wallet must go down by exactly the total, and the id must
      // be "<uid>_<requestId>" so retries reuse the same id.
      allow create: if signedIn()
        && orderId == request.auth.uid + '_' + request.resource.data.requestId
        && request.resource.data.keys().hasOnly([
          'uid', 'requestId', 'items', 'subtotal', 'serviceFee', 'deliveryFee', 'total',
          'status', 'delivery', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && isText(request.resource.data.requestId, 80)
        && request.resource.data.requestId.size() >= 8
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 5
        && request.resource.data.status == 'paid'
        // The order is collected at a pickup station: the delivery map must carry that
        // station's id, name, state and address exactly as the catalogue has them.
        && request.resource.data.delivery is map
        && request.resource.data.delivery.keys().hasOnly([
          'method', 'country', 'state', 'stationId', 'stationName', 'stationAddress', 'landmark'
        ])
        && request.resource.data.delivery.method == 'pickup'
        && request.resource.data.delivery.country == 'Nigeria'
        && request.resource.data.delivery.stationId is string
        && request.resource.data.delivery.stationId.matches('^[A-Za-z0-9_-]{2,40}$')
        && exists(/databases/$(database)/documents/pickupStations/$(request.resource.data.delivery.stationId))
        && pickupStation(request.resource.data.delivery.stationId).active == true
        && request.resource.data.delivery.stationName == pickupStation(request.resource.data.delivery.stationId).name
        && request.resource.data.delivery.state == pickupStation(request.resource.data.delivery.stationId).state
        && request.resource.data.delivery.stationAddress == pickupStation(request.resource.data.delivery.stationId).address
        && request.resource.data.delivery.landmark == pickupStation(request.resource.data.delivery.stationId).get('landmark', '')
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.subtotal is int
        && request.resource.data.serviceFee is int
        && request.resource.data.deliveryFee is int
        && request.resource.data.total is int
        && request.resource.data.total >= 1
        && (request.resource.data.items.size() <= 0 || lineMatchesProduct(request.resource.data.items[0]))
        && (request.resource.data.items.size() <= 1 || lineMatchesProduct(request.resource.data.items[1]))
        && (request.resource.data.items.size() <= 2 || lineMatchesProduct(request.resource.data.items[2]))
        && (request.resource.data.items.size() <= 3 || lineMatchesProduct(request.resource.data.items[3]))
        && (request.resource.data.items.size() <= 4 || lineMatchesProduct(request.resource.data.items[4]))
        && request.resource.data.subtotal == numAt(request.resource.data.items, 0, 'lineTotal')
             + numAt(request.resource.data.items, 1, 'lineTotal')
             + numAt(request.resource.data.items, 2, 'lineTotal')
             + numAt(request.resource.data.items, 3, 'lineTotal')
             + numAt(request.resource.data.items, 4, 'lineTotal')
        && request.resource.data.serviceFee == serviceFeeAmount()
        && request.resource.data.deliveryFee == deliveryFeeAmount(request.resource.data.delivery)
        && request.resource.data.total == request.resource.data.subtotal
             + request.resource.data.serviceFee
             + request.resource.data.deliveryFee
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance
             == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('balance', 0) - request.resource.data.total
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance >= 0;

      // Admin moves an order forward, or cancels it. The client does the refund and restock
      // in the same batch.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt'])
        && ((resource.data.status == 'paid' && request.resource.data.status in ['processing', 'cancelled'])
          || (resource.data.status == 'processing' && request.resource.data.status in ['shipped', 'cancelled'])
          || (resource.data.status == 'shipped' && request.resource.data.status == 'delivered'));

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Social media boosting: catalogue and orders
    // ---------------------------------------------------------------

    // Platforms (Facebook, TikTok, YouTube, …) — the description shoppers see on the
    // platform's boost page is stored here.
    match /boostPlatforms/{platformId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && platformId.matches('^[A-Za-z0-9_-]{2,40}$')
        && isText(request.resource.data.name, 80)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.active is bool;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Categories inside a platform (Followers, Likes, Views, …).
    match /boostCategories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && categoryId.matches('^[A-Za-z0-9_-]{2,40}$')
        && isText(request.resource.data.platformId, 40)
        && isText(request.resource.data.name, 80)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.active is bool;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Subcategories — the plans shoppers order, each with its own price per unit,
    // optional order limits (minQuantity, maxQuantity where 0/blank means no
    // maximum) and an average delivery time. The price may be a fraction of ₦1
    // (as low as ₦0.10, in kobo steps) — the order total is rounded to whole
    // naira there. The limits are enforced in the app's order transaction, which
    // re-reads the plan; the rules below still pin the price, names and wallet
    // debit, so bypassing a limit cannot change what is charged.
    match /boostSubcategories/{subcategoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && subcategoryId.matches('^[A-Za-z0-9_-]{2,40}$')
        && isText(request.resource.data.categoryId, 40)
        && isText(request.resource.data.name, 120)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && isText(request.resource.data.unit, 60)
        && request.resource.data.price is number
        && request.resource.data.price >= 0.1
        && (!('minQuantity' in request.resource.data) || (request.resource.data.minQuantity is int && request.resource.data.minQuantity >= 1))
        && (!('maxQuantity' in request.resource.data) || (request.resource.data.maxQuantity is int && request.resource.data.maxQuantity >= 0))
        && (!('averageTime' in request.resource.data) || (request.resource.data.averageTime is string && request.resource.data.averageTime.size() <= 120))
        && request.resource.data.active is bool;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Boost orders: /boostOrders/{uid}_{requestId} — one service, paid from the wallet.
    // No delivery and no checkout fees: the total is the catalogue's unit price × the
    // quantity, rounded to whole naira (the plan price may be a fraction of ₦1). The
    // id is "<uid>_<requestId>" so retries reuse the same id.
    match /boostOrders/{orderId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();

      allow create: if signedIn()
        && orderId == request.auth.uid + '_' + request.resource.data.requestId
        && request.resource.data.keys().hasOnly([
          'uid', 'requestId', 'platformId', 'platformName', 'categoryId', 'categoryName',
          'subcategoryId', 'subcategoryName', 'unit', 'unitPrice', 'quantity', 'total',
          'link', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && isText(request.resource.data.requestId, 80)
        && request.resource.data.requestId.size() >= 8
        && request.resource.data.status == 'paid'
        && isText(request.resource.data.platformId, 40)
        && isText(request.resource.data.categoryId, 40)
        && isText(request.resource.data.subcategoryId, 40)
        && request.resource.data.platformName is string && request.resource.data.platformName.size() <= 80
        && request.resource.data.categoryName is string && request.resource.data.categoryName.size() <= 80
        && request.resource.data.subcategoryName is string && request.resource.data.subcategoryName.size() <= 120
        && request.resource.data.unit is string && request.resource.data.unit.size() <= 60
        && request.resource.data.link is string
        && request.resource.data.link.size() >= 1
        && request.resource.data.link.size() <= 300
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.unitPrice is number
        && request.resource.data.unitPrice >= 0.1
        && request.resource.data.total is int
        && request.resource.data.total
             == boostOrderTotal(request.resource.data.unitPrice, request.resource.data.quantity)
        // The catalogue as it is now decides the price and the names on the order.
        && get(/databases/$(database)/documents/boostSubcategories/$(request.resource.data.subcategoryId)).data.price == request.resource.data.unitPrice
        && get(/databases/$(database)/documents/boostSubcategories/$(request.resource.data.subcategoryId)).data.name == request.resource.data.subcategoryName
        && get(/databases/$(database)/documents/boostSubcategories/$(request.resource.data.subcategoryId)).data.unit == request.resource.data.unit
        && get(/databases/$(database)/documents/boostSubcategories/$(request.resource.data.subcategoryId)).data.categoryId == request.resource.data.categoryId
        && get(/databases/$(database)/documents/boostSubcategories/$(request.resource.data.subcategoryId)).data.active == true
        && get(/databases/$(database)/documents/boostCategories/$(request.resource.data.categoryId)).data.name == request.resource.data.categoryName
        && get(/databases/$(database)/documents/boostCategories/$(request.resource.data.categoryId)).data.platformId == request.resource.data.platformId
        && get(/databases/$(database)/documents/boostCategories/$(request.resource.data.categoryId)).data.active == true
        && get(/databases/$(database)/documents/boostPlatforms/$(request.resource.data.platformId)).data.name == request.resource.data.platformName
        && get(/databases/$(database)/documents/boostPlatforms/$(request.resource.data.platformId)).data.active == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance
             == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('balance', 0) - request.resource.data.total
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance >= 0;

      // Admin starts the work, delivers it, or cancels and refunds (the client does
      // the wallet refund in the same batch).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt'])
        && ((resource.data.status == 'paid' && request.resource.data.status in ['processing', 'cancelled'])
          || (resource.data.status == 'processing' && request.resource.data.status in ['delivered', 'cancelled']));

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Funding requests: /fundingRequests/{requestId}
    // ---------------------------------------------------------------
    match /fundingRequests/{requestId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'amount', 'reference', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount >= 100
        && request.resource.data.amount <= 5000000
        && isText(request.resource.data.reference, 120)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;

      // Only the admin reviews, and only a pending request can be reviewed.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']);

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Recommended-product announcements: /notifications/{id}
    // Written by the admin when a product is listed as "recommended"; every visitor's
    // browser watches this feed and raises a notification.
    // ---------------------------------------------------------------
    match /notifications/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'productId', 'name', 'createdAt'])
        && request.resource.data.type == 'recommended'
        && isText(request.resource.data.productId, 40)
        && isText(request.resource.data.name, 120)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Ledger: /ledger/{entryId}. Admin reads. Customers write only their own purchases.
    // ---------------------------------------------------------------
    match /ledger/{entryId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.type == 'purchase'
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.reference)).data.uid == request.auth.uid
        && request.resource.data.amount == -getAfter(/databases/$(database)/documents/orders/$(request.resource.data.reference)).data.total;
      allow create: if signedIn()
        && request.resource.data.type == 'boost'
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/boostOrders/$(request.resource.data.reference)).data.uid == request.auth.uid
        && request.resource.data.amount == -getAfter(/databases/$(database)/documents/boostOrders/$(request.resource.data.reference)).data.total;
      allow create, update, delete: if isAdmin();
    }

    // Anything not matched above is denied by default.
  }
}
